# Copie este arquivo para .env e ajuste os valores.
# As mesmas variáveis são usadas pelo Docker Compose e pela API.

POSTGRES_USER=healthops
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=healthops

# Endereço do banco visto pela API (porta exposta pelo Compose no host)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
